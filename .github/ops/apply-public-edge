#!/bin/bash
# Switch the EuroCards-owned include on the shared Caddy gateway.
set -Eeuo pipefail
umask 077
mode=${1:-}
[[ "$mode" == http || "$mode" == https ]] || { echo "Usage: $0 http|https" >&2; exit 2; }
[[ $EUID == 0 ]]
edge=premsales-live-edge
volume=$(docker volume inspect --format '{{.Mountpoint}}' premsales-edge-certificates)
base="$volume/eurocards-edge"
origin="$base/origin.caddy"
public="$base/public.caddy"
include='import /etc/letsencrypt/eurocards-edge/public.caddy'
source="/etc/eurocards/public-$mode.caddy"
hosts=(evrocards.ru www.evrocards.ru xn--80adhb0axndk.xn--p1ai www.xn--80adhb0axndk.xn--p1ai)
exec 9>/var/lib/eurocards/letsencrypt/.sync-edge.lock
flock -x 9
[[ -f "$origin" && -f "$source" ]]
if [[ "$mode" == http && -f "$public" ]] && grep -Fq 'tls /etc/letsencrypt/eurocards-edge/public' "$public"; then
    echo "Public HTTPS is already configured" >&2
    exit 1
fi
local_get() {
    local scheme=$1 host=$2 path=$3
    local port=443
    [[ "$scheme" == https ]] || port=80
    curl -fsS --noproxy '*' --max-time 5 --resolve "$host:$port:127.0.0.1" "$scheme://$host$path"
}
origins_healthy() {
    local_get https origin.evrocards.ru /release.json | grep -q '"revision"' &&
        local_get https origin.premsales.ru /_premsales_origin_ready | grep -q premsales-ovh-ready
}
origins_healthy
backup=$(mktemp -d /var/lib/eurocards/backups/public.XXXXXXXX)
cp -p "$origin" "$backup/origin.caddy"
if [[ -f "$public" ]]; then cp -p "$public" "$backup/public.caddy"; fi
probe=$(mktemp /var/lib/eurocards/acme/.well-known/acme-challenge/ec-probe.XXXXXXXX)
trap 'rm -f -- "$probe"' EXIT
printf '%s\n' "${probe##*/}" > "$probe"
chmod 644 "$probe"
restore() {
    local rc=$?
    trap - ERR
    cp -p "$backup/origin.caddy" "$origin"
    if [[ -f "$backup/public.caddy" ]]; then
        cp -p "$backup/public.caddy" "$public"
    else
        rm -f -- "$public"
    fi
    docker exec "$edge" caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile &&
        docker kill --signal=USR1 "$edge" >/dev/null
    echo "Restored previous EuroCards edge settings from $backup" >&2
    exit "$rc"
}
trap restore ERR
install -m 0600 -- "$source" "$base/.public-next.caddy"
mv -f -- "$base/.public-next.caddy" "$public"
if ! grep -Fxq "$include" "$origin"; then printf '\n%s\n' "$include" >> "$origin"; fi
docker exec "$edge" caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
docker kill --signal=USR1 "$edge" >/dev/null
ready() {
    local host code
    local sample='/journal/card-top-up.html?via=check'
    origins_healthy || return 1
    for host in "${hosts[@]}"; do
        [[ $(local_get http "$host" "/.well-known/acme-challenge/${probe##*/}") == "${probe##*/}" ]] || return 1
        if [[ "$mode" == http || "$host" == evrocards.ru ]]; then
            local_get "$mode" "$host" /release.json | grep -q '"revision"' || return 1
        else
            code=$(curl -fsS --noproxy '*' -o /dev/null --max-time 5 --resolve "$host:443:127.0.0.1" \
                -w '%{http_code} %{redirect_url}' "https://$host$sample") || return 1
            [[ "$code" == "308 https://evrocards.ru$sample" ]] || return 1
        fi
    done
}
for attempt in {1..10}; do
    if ready; then
        trap - ERR
        echo "Verified public $mode for four names; EuroCards origin and PREMSALES verified"
        exit 0
    fi
    sleep 1
done
echo "Public edge checks failed" >&2
false
